{
  "name": "real-estate-ai",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "db:dev": "npm run db:dev -w apps/api",
    "db:push": "npm run db:push -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "install:mobile": "npm --prefix apps/mobile install",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm test -w apps/api"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
