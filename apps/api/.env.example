DATABASE_URL=postgresql://realestate:realestate@localhost:5441/realestate
PORT=4100
BRAND_NAME=HomeAsk

# Optional. Without a key, /ask answers with the built-in question parser instead of Claude.
ANTHROPIC_API_KEY=
# Optional override, e.g. claude-haiku-5-5 for lower cost and latency.
ASSISTANT_MODEL=claude-opus-5-5

# Admin panel sign-in (the site's /admin). Local development values; set real ones, and a long random ADMIN_SECRET, in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=local-dev-only-change-me
ADMIN_SECRET=

# Optional: where uploaded listing photos are stored. Defaults to apps/api/uploads.
# UPLOAD_DIR=

# Public address of the website, used in the links inside emails.
SITE_URL=http://localhost:3210

# Email (confirm-your-email, password reset, new-enquiry notices). Any SMTP service works, for example
# smtps://USER:PASSWORD@smtp.example.com:465. Without SMTP_URL nothing is sent: each email is written to the API log instead.
SMTP_URL=
MAIL_FROM="HomeAsk <no-reply@homeask.example>"

# Daily email about leads still marked New a day after arriving (to the seller, the builder, or staff when nobody else
# is handling them). Sent once a day at this hour, India time. Set REMINDERS=off to disable.
REMINDERS=on
REMINDER_HOUR_IST=9

# Verification documents that sellers upload (identity, RERA certificate, ownership proof). Kept in a private folder
# that is never served publicly, and deleted this many days after the seller's review.
# DOCUMENT_DIR=
DOCUMENT_RETENTION_DAYS=90
