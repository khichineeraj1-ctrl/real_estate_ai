{
  "name": "@realestate/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "node --import tsx --test src/**/*.spec.ts",
    "db:dev": "node scripts/dev-db.mjs",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:builders": "tsx prisma/link-builders.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@prisma/client": "^6.19.3",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
