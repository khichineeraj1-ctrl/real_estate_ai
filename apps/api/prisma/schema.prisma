generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  APARTMENT
  VILLA
  BUILDER_FLOOR
  PLOT
}

enum ConstructionStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
}

enum Role {
  ADMIN /// everything, including managing users
  EDITOR /// all content and approvals, but not users
  AGENT /// an owner or agent posting their own listings, which staff approve
  BUILDER /// a builder's sales team: sees the leads on the projects staff have assigned to them, nothing else
  WRITER /// writes guides and blog posts; staff publish them. Sees nothing else.
}

enum ListingState {
  PUBLISHED
  PENDING
  REJECTED
}

enum ListedBy {
  OWNER
  BUILDER
  AGENT
}

model City {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  state      String
  intro      String
  lat        Float
  lng        Float
  localities Locality[]
  /// Government charges on a purchase in this city, used by the "true cost" calculator. Percent of the price.
  stampDutyPct       Float?
  /// Rate when the sole buyer is a woman, where the state gives a concession; same as stampDutyPct otherwise.
  stampDutyWomenPct  Float?
  registrationPct    Float?
  /// Upper limit on the registration fee in rupees, where the state caps it.
  registrationCapInr Int?
  /// Shown to buyers under the estimate: what the figures leave out or where they differ.
  costNote           String?
  /// When someone on our team last checked these against the official rates. Null means never checked.
  costReviewedAt     DateTime?
}

model Locality {
  id         String     @id @default(cuid())
  slug       String
  name       String
  intro      String
  highlights String[]
  lat        Float
  lng        Float
  cityId     String
  city       City       @relation(fields: [cityId], references: [id])
  projects   Project[]
  properties Property[]

  @@unique([cityId, slug])
  upcoming UpcomingProject[]
}

/// A builder as buyers know it: one page listing every project of the group, whichever of its companies registered each one.
model Builder {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  projects Project[]
  /// Set when this builder was merged into another. The row is kept so its old address leads to the other builder,
  /// and so later projects registered under the same company name go to that builder too.
  mergedIntoId String?
  mergedInto   Builder?  @relation("Merged", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Builder[] @relation("Merged")
}

model Project {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  /// The promoter's name as registered or entered, e.g. "DLF Home Developers Limited".
  builder     String
  /// The builder page this project is listed under. The project's address is /builders/<builder>/<project>.
  brandId     String?
  brand       Builder?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  description String
  status      ConstructionStatus
  possession  DateTime?
  reraId      String?
  /// Unknown for projects taken from a RERA register, which does not list it.
  totalUnits  Int?
  amenities   String[]
  /// Set when this project page was created from a public RERA register rather than entered by our team or the builder.
  registerSource     RegisterSource?
  /// The register's own status wording, e.g. "Registered", "APPROVED" or "Lapsed".
  registerStatus     String?
  registerValidUntil DateTime?
  sourceUrl          String?
  sourceFetchedAt    DateTime?
  register           RegisterProject?
  /// When the page was made, so alerts can tell which projects are new.
  createdAt          DateTime           @default(now())
  watches            ProjectWatch[]
  wasUpcoming        UpcomingProject[]
  savedBy            SavedItem[]
  /// The builder's sales address. When set, each lead on this project is emailed there as it arrives.
  leadEmail   String?
  /// The builder login that may see this project's leads.
  accountId   String?
  account     User?              @relation("ProjectAccount", fields: [accountId], references: [id], onDelete: SetNull)
  localityId  String
  locality    Locality           @relation(fields: [localityId], references: [id])
  properties  Property[]
  enquiries   Enquiry[]
  sellers     ProjectSeller[]
  photos      Photo[]
  videos      Video[]

  @@index([brandId])
}

model Property {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  description String
  type        PropertyType
  bhk         Int // 0 for plots
  bathrooms   Int
  priceInr    Int
  areaSqft    Int
  floor       Int?
  totalFloors Int?
  facing      String?
  furnishing  String?
  status      ConstructionStatus
  possession  DateTime?
  amenities   String[]
  listedBy    ListedBy
  postedAt    DateTime           @default(now())
  localityId  String
  locality    Locality           @relation(fields: [localityId], references: [id])
  projectId   String?
  project     Project?           @relation(fields: [projectId], references: [id])
  /// Only PUBLISHED listings appear on the site, in answers and in the sitemap.
  state        ListingState      @default(PUBLISHED)
  rejectReason String?
  ownerId      String?
  owner        User?             @relation(fields: [ownerId], references: [id])
  photos       Photo[]
  videos      Video[]
  /// Set by staff after seeing the ownership papers or visiting the home. The strongest single signal of confidence.
  staffVerified     Boolean   @default(false)
  staffVerifiedNote String?
  staffVerifiedAt   DateTime?
  staffVerifiedBy   String?
  /// Confidence level 0-3, worked out from the seller's verification and this listing's own checks (see src/trust).
  /// Stored so listings can be ordered by it; recomputed whenever something it depends on changes, and daily.
  confidence        Int       @default(0)
  enquiries    Enquiry[]
  reports      Report[]
  savedBy      SavedItem[]

  @@index([localityId, bhk])
  @@index([priceInr])
  @@index([confidence, postedAt])
}

/// What buyers asked, kept to see which searches find nothing. Text and time only: no visitor identity.
model Question {
  id        String   @id @default(cuid())
  text      String
  live      Boolean
  total     Int
  /// Set when nothing matched as asked and the search was widened: which filter was dropped (budget, locality, status).
  relaxed   String?
  page      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  phone        String?
  passwordHash String
  role         Role
  active       Boolean    @default(true)
  /// Null until the person has opened the link sent to their email. Owners and agents cannot post before that.
  emailVerified DateTime?
  createdAt    DateTime   @default(now())
  properties   Property[]
  emailTokens  EmailToken[]
  projects     Project[]  @relation("ProjectAccount")
  dealer       DealerProfile?
  reportsAbout Report[]   @relation("ReportsAboutSeller")
  /// Projects this agent sells, and the leads passed to them from those projects.
  selling      ProjectSeller[]
  assignedLeads Enquiry[]  @relation("AssignedLeads")
  videosAdded Video[] @relation("VideosAdded")
  upcomingSubmitted UpcomingProject[] @relation("UpcomingSubmitted")
  articles Article[] @relation("ArticlesWritten")
}

enum ProjectSellerStatus {
  REQUESTED /// the agent asked to be listed for the project
  APPROVED  /// staff confirmed it: buyers can be connected to this agent for the project
  REJECTED
}

/// A verified agent who sells a builder's project. Buyers who press "Connect with a verified agent" on that project
/// are passed to one of its approved agents.
model ProjectSeller {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ProjectSellerStatus @default(REQUESTED)
  /// What the agent told us about how they sell this project (e.g. an authorised channel partner).
  note      String?
  /// Shown to the agent when the request is turned down.
  decisionNote String?
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, status])
}

/// A video of a home or a builder's project, hosted on YouTube: we keep only its YouTube id and a title.
model Video {
  id         String   @id @default(cuid())
  youtubeId  String
  title      String?
  position   Int
  /// False while a video sent in by an agent waits for our team to look at it; buyers see only approved videos.
  approved   Boolean  @default(true)
  /// The verified agent who sent it in, credited beside the video. Null for videos our team added.
  addedById  String?
  addedBy    User?    @relation("VideosAdded", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
  @@index([projectId, position])
}

model Photo {
  id         String   @id @default(cuid())
  /// File name inside the upload folder; the first photo by position is the cover.
  file       String   @unique
  position   Int
  createdAt  DateTime @default(now())
  width      Int
  height     Int
  /// What the photo shows, for grouping in the gallery: one of the codes in src/admin/photos.ts, or empty.
  category   String?
  /// A photo belongs to one home, one builder's project, or one land listing: exactly one of the three is set.
  landId     String?
  /// A fingerprint of the stored picture, so the same photo is not added to one listing twice. Empty on older photos.
  hash       String?
  land       LandListing? @relation(fields: [landId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
  @@index([projectId, position])
  @@index([landId, position])
}

enum EmailTokenKind {
  VERIFY
  RESET
}

/// A one-time link sent by email. Only a hash of the secret is stored, so a copy of the database cannot be used to sign in.
model EmailToken {
  id        String         @id @default(cuid())
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum LeadStatus {
  NEW
  CONTACTED
  VISIT_PLANNED
  BOOKED
  NOT_INTERESTED
}

/// A buyer asking to be contacted about a listing.
model Enquiry {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String?
  message    String?
  /// What the buyer said they want on a project lead, e.g. "3 BHK".
  interest   String?
  /// What the buyer told us about their plans, each optional: when they mean to buy, their budget, how they will pay,
  /// what the home is for, and whether they asked for a site visit. Stored as the short codes in src/leads/score.ts.
  timeline   String?
  budget     String?
  loan       String?
  purpose    String?
  wantsVisit Boolean  @default(false)
  /// How the buyer had used the site before enquiring (pages seen, tools used), as their browser reported it.
  signals    Json?
  /// How likely this buyer is to go ahead, 0 to 100, worked out when the enquiry arrives, with the reasons for it.
  score        Int    @default(0)
  scoreBand    String @default("COLD")
  scoreReasons Json?
  /// Our own team's follow-up: where it stands, and a short private note. Never shown to the buyer, seller or builder.
  status     LeadStatus @default(NEW)
  note       String?
  statusAt   DateTime?
  /// The follow-up of the outside party this lead belongs to: the listing's seller, or the project's builder.
  /// Kept apart from ours so neither side overwrites the other. Staff can read it; the partner cannot read ours.
  partnerStatus   LeadStatus @default(NEW)
  partnerNote     String?
  partnerStatusAt DateTime?
  /// The verified agent this lead was passed to, when the buyer asked to be connected to one.
  assignedToId String?
  assignedTo   User?    @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  events     LeadEvent[]
  /// The buyer's own account, when they were signed in as they enquired, so they can see what they sent.
  buyerId    String?
  buyer      Buyer?   @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  /// Set for an enquiry about one listing.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Set for a lead on a builder project, and for a listing enquiry when that listing belongs to a project.
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@index([partnerStatus, createdAt])
  @@index([score])
  @@index([assignedToId, createdAt])
  @@index([phone, createdAt])
}

enum LeadParty {
  STAFF
  PARTNER
}

/// One entry in a lead's trail: who changed its status or note, and when.
model LeadEvent {
  id         String     @id @default(cuid())
  party      LeadParty
  fromStatus LeadStatus
  toStatus   LeadStatus
  note       String?
  /// The person's name at the time, kept even if the account is later renamed or deactivated.
  byName     String
  byUserId   String?
  createdAt  DateTime   @default(now())
  enquiryId  String
  enquiry    Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, createdAt])
}

/// Remembers the last day a daily job ran, so it runs once a day even across restarts or several API servers.
model JobRun {
  name    String @id
  lastDay String
}

enum DealerKind {
  OWNER /// selling their own home
  AGENT /// a broker selling for others
  BUILDER /// a developer's sales office
}

enum DealerStatus {
  DRAFT /// answers saved, not yet sent for review
  SUBMITTED
  NEEDS_INFO /// staff asked for something more
  APPROVED
  REJECTED
}

/// What a seller told us about themselves at onboarding, and what our staff then verified.
model DealerProfile {
  userId          String       @id
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            DealerKind
  firmName        String?
  yearsInBusiness Int?
  officeAddress   String?
  cities          String[]
  reraNumber      String?
  gstNumber       String?
  website         String?
  /// For an owner: how they are connected to the home (owner, family, power of attorney).
  ownerRelation   String?
  about           String?
  status          DealerStatus @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  /// Shown to the dealer: why more is needed, or why they were turned down.
  reviewNote      String?
  /// For staff only.
  internalNote    String?
  /// What a staff member confirmed. Nothing counts towards confidence unless one of these is ticked.
  checkIdentity   Boolean      @default(false)
  checkRera       Boolean      @default(false) /// RERA registration found on the state site; for an owner, ownership papers seen
  checkPhone      Boolean      @default(false) /// spoke to them on the number they gave
  checkAddress    Boolean      @default(false) /// office or home address confirmed
  /// Complaints from buyers that staff judged to be genuine.
  complaints      Int          @default(0)
  /// Confidence level 0-3, stored for ordering and recomputed with the listings.
  level           Int          @default(0)
  documents       DealerDocument[]
}

enum DocumentKind {
  RERA_CERTIFICATE
  ID_PROOF
  BUSINESS_PROOF
  OWNERSHIP_PROOF
}

/// A verification document a dealer uploaded. The file is kept outside the public upload folder and is only ever
/// sent to that dealer or to staff. Deleted automatically some days after the review (DOCUMENT_RETENTION_DAYS).
model DealerDocument {
  id        String        @id @default(cuid())
  kind      DocumentKind
  file      String        @unique
  mime      String
  sizeBytes Int
  createdAt DateTime      @default(now())
  userId    String
  profile   DealerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

enum ReportReason {
  FAKE_LISTING /// the home does not exist or is not for sale
  ASKED_ADVANCE /// asked for money before a visit or papers
  NOT_THE_OWNER /// the seller has no right to sell it
  WRONG_DETAILS /// price, size, photos or status are not as listed
  UNREACHABLE /// never answers, or was abusive
  OTHER
}

enum ReportStatus {
  NEW
  UPHELD
  DISMISSED
}

/// A buyer telling us something is wrong with a listing or its seller. It changes nothing by itself: only a report
/// that staff look into and uphold counts against the seller.
model Report {
  id            String       @id @default(cuid())
  reason        ReportReason
  details       String
  reporterName  String
  reporterPhone String
  /// Optional: where to send the outcome.
  reporterEmail String?
  /// An unguessable code in the private link the buyer is given to check the outcome.
  publicToken   String       @unique
  /// What staff chose to tell the buyer about the outcome, in addition to the standard wording.
  buyerNote     String?
  /// Whether the listing was taken off the site when the report was upheld.
  tookDown      Boolean      @default(false)
  status        ReportStatus @default(NEW)
  staffNote     String?
  decidedAt     DateTime?
  decidedBy     String?
  createdAt     DateTime     @default(now())
  /// Kept as text too, so the report still makes sense if the listing is later deleted.
  listingTitle  String
  propertyId    String?
  property      Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  /// The seller's account, when the listing has an outside seller.
  sellerId      String?
  seller        User?        @relation("ReportsAboutSeller", fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([sellerId, status])
}

enum RegisterSource {
  HARYANA
  KARNATAKA
  MAHARASHTRA
}

/// One project as a state RERA register lists it, kept exactly as fetched. Entries we can place in one of our
/// localities are published as project pages; the rest wait here for a person to place or ignore.
model RegisterProject {
  id             String         @id @default(cuid())
  source         RegisterSource
  regNo          String
  name           String
  promoter       String
  district       String
  locationText   String
  pincode        String?
  lat            Float?
  lng            Float?
  projectType    String?
  registerStatus String?
  validUntil     DateTime?
  sourceUrl      String
  fetchedAt      DateTime
  /// How the locality was decided, in words, for whoever reviews it.
  placedHow      String?
  /// What the builder declared in its registration application (Haryana's Form A-H), as written, unchecked.
  declaredLitigation Boolean?
  declaredApartments Int?
  declaredTowers     Int?
  declaredStart      DateTime?
  declaredCompletion DateTime?
  /// When the application form was last read; null until it has been.
  formFetchedAt      DateTime?
  projectId      String?        @unique
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([source, regNo])
  @@index([source, projectId])
}

/// A home buyer's own account: what they saved, what they asked about, and what they ticked off, on any device.
/// They sign in with a code sent to their email; there is no password.
model Buyer {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Compare shortlists and checklist ticks, kept in step with the browser or app. Small, and theirs alone.
  state     Json?
  createdAt DateTime @default(now())
  sessions  BuyerSession[]
  saved     SavedItem[]
  enquiries Enquiry[]
  alerts    SearchAlert[]
}

/// A sign-in code sent by email. Only its hash is kept; it works once, for ten minutes, and gives up after five wrong tries.
model BuyerCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model BuyerSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// A project or home a buyer saved, with their own note.
model SavedItem {
  id         String    @id @default(cuid())
  buyerId    String
  buyer      Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime  @default(now())

  @@unique([buyerId, projectId])
  @@unique([buyerId, propertyId])
}

/// "Tell me when something new appears here": new projects on the register, or new homes for sale, in a city or one
/// of its localities. One email per batch of new matches; every email carries a link that stops the alert.
model SearchAlert {
  id        String   @id @default(cuid())
  email     String
  buyerId   String?
  buyer     Buyer?   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  /// "PROJECTS" or "HOMES".
  kind      String
  citySlug  String
  localitySlug String?
  /// For homes: at most this price, and this many bedrooms. Null means any.
  maxPriceInr Int?
  bhk         Int?
  token     String   @unique
  /// Only things that appeared after this are news.
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([email])
}

/// A project a verified agent or a builder has told us is coming but that is not on a RERA register yet. It is shown
/// as information only ("not yet registered, not for sale"), never with a price, and only after our team approves it.
/// When its registration appears, staff link it to the real project page and it leaves this list.
model UpcomingProject {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  /// The builder's name as the submitter gave it.
  builder       String
  localityId    String
  locality      Locality @relation(fields: [localityId], references: [id])
  about         String?
  /// When the builder expects to register and launch, in the submitter's words, e.g. "Early 2027".
  expected      String?
  youtubeId     String?
  videoTitle    String?
  /// "PENDING", "APPROVED" or "REJECTED".
  status        String   @default("PENDING")
  decisionNote  String?
  submittedById String?
  submittedBy   User?    @relation("UpcomingSubmitted", fields: [submittedById], references: [id], onDelete: SetNull)
  /// Set once the project is registered and has its own page; the entry then stops showing as upcoming.
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  decidedAt     DateTime?
  watches       UpcomingWatch[]

  @@index([status, createdAt])
}

/// "Tell me when it is registered": one email, sent when the upcoming project gets its RERA registration.
model UpcomingWatch {
  id         String   @id @default(cuid())
  email      String
  upcomingId String
  upcoming   UpcomingProject @relation(fields: [upcomingId], references: [id], onDelete: Cascade)
  token      String   @unique
  createdAt  DateTime @default(now())

  @@unique([email, upcomingId])
}

/// A guide or blog post written by a member of the team with a writer's login. It is a draft until the writer sends
/// it for review, and buyers see it only once an editor or admin publishes it.
model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  /// "GUIDE" or "BLOG".
  kind        String
  title       String
  summary     String
  /// Plain text with a little markup: "## " for a heading, "- " for a list item, **bold**, [text](link).
  body        String
  /// "DRAFT", "SUBMITTED" or "PUBLISHED".
  status      String    @default("DRAFT")
  /// What the reviewer asked to be changed, when a piece is sent back.
  reviewNote  String?
  authorId    String?
  author      User?     @relation("ArticlesWritten", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status, kind, publishedAt])
}

/// A buyer following a project: they are emailed when its RERA registration changes (lapses, is extended, or ends).
model ProjectWatch {
  id        String   @id @default(cuid())
  email     String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Sent in every email, so one click stops the alerts without signing in.
  token     String   @unique
  /// What the register said when they started following, or when we last told them.
  lastStatus     String?
  lastValidUntil DateTime?
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([email, projectId])
}

/// One run of the register importer, so staff can see when each register was last read and what came of it.
model ImportRun {
  id         String         @id @default(cuid())
  source     RegisterSource
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  fetched    Int            @default(0)
  added      Int            @default(0)
  published  Int            @default(0)
  requests   Int            @default(0)
  note       String?
  error      String?
}

/// Land and commercial space anywhere in India: farm land, plots, industrial land, and built space to rent. Kept apart
/// from homes because it is placed by state, district and village rather than by the cities we cover, and is posted
/// by owners who have no account. Rules live in src/land.
model LandListing {
  id          String   @id @default(cuid())
  slug        String   @unique
  /// "FARM", "PLOT", "INDUSTRIAL" or "BUILT" (a ready warehouse, shed or shop).
  kind        String
  /// "SALE" or "LEASE".
  deal        String
  title       String
  description String?
  stateSlug    String
  state        String
  districtSlug String
  district     String
  /// Town or village, in the poster's words.
  place        String
  /// The size as the poster gave it, in the unit they use locally.
  areaValue   Float
  areaUnit    String
  /// The same size in square feet when the unit has one fixed size everywhere; null for units that vary by region.
  areaSqft    Float?
  /// Asking price for a sale, or the monthly rent for a lease, in rupees. Null means "ask".
  priceInr    BigInt?
  /// Width of the road the land or building opens on, in feet.
  roadFt      Int?
  /// The nearest highway or main road, and how far it is, in the poster's words: "NH-48" and 3.5.
  highway     String?
  highwayKm   Float?
  /// What the land records allow, as the poster says: "AGRICULTURAL", "RESIDENTIAL", "COMMERCIAL", "INDUSTRIAL" or null if they do not know.
  landUse     String?
  features    String[]
  /// Built space only.
  clearHeightFt Int?
  powerKva      Int?
  docks         Int?
  /// "OWNER", "DEALER" or "COMPANY".
  posterIs    String
  posterName  String
  posterPhone String
  posterEmail String?
  /// Hash of the private link the poster uses to mark it sold or take it down.
  manageHash  String   @unique
  /// "PENDING", "LIVE", "REJECTED" or "CLOSED" (sold, let, or withdrawn by the poster).
  status      String   @default("PENDING")
  decisionNote String?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
  replies     LandReply[]
  photos      Photo[]

  @@index([status, stateSlug, districtSlug])
  @@index([status, kind, createdAt])
}

/// A requirement: someone, usually a company, says what land or space they are looking for so owners can answer.
model LandWanted {
  id          String   @id @default(cuid())
  slug        String   @unique
  kind        String
  deal        String
  /// What it is for: "WAREHOUSE", "DARK_STORE", "FACTORY", "RETAIL", "FARMING", "HOUSING" or "OTHER".
  purpose     String
  title       String
  details     String?
  stateSlug   String
  state       String
  /// Districts or towns they will consider, in their words. Empty means anywhere in the state.
  where       String?
  areaMin     Float
  areaMax     Float?
  areaUnit    String
  budgetInr   BigInt?
  /// Shown publicly only if they ask for it to be.
  company     String?
  showCompany Boolean  @default(false)
  posterName  String
  posterPhone String
  posterEmail String?
  manageHash  String   @unique
  status      String   @default("PENDING")
  decisionNote String?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
  replies     LandReply[]

  @@index([status, stateSlug, createdAt])
}

/// A buyer's enquiry on a listing, or an owner's answer to a requirement. Read by our team, who make the introduction.
model LandReply {
  id        String   @id @default(cuid())
  listingId String?
  listing   LandListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  wantedId  String?
  wanted    LandWanted?  @relation(fields: [wantedId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  message   String?
  /// "NEW" or "DONE": whether our team has followed it up.
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Investor corner: a place where a government plan (a new city, an airport, a corridor, an industrial zone) is
/// changing what land is for. Written by our team from the official documents, which are always linked. It states
/// what is planned and how far along it is; it never predicts prices or returns. Rules live in src/invest.
model InvestArea {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  /// What is driving it: "CITY", "AIRPORT", "CORRIDOR", "INDUSTRIAL", "TRANSIT", "PORT" or "OTHER".
  driver    String
  stateSlug String
  state     String
  /// Districts it touches, tidied the same way as land listings so the two can be matched.
  districts     String[]
  districtSlugs String[]
  summary   String
  /// What the plan says, in our words, as paragraphs.
  plan      String
  /// How far along: "ANNOUNCED", "APPROVED", "LAND", "BUILDING" or "OPEN".
  stage     String
  stageNote String?
  /// The body in charge, e.g. a development authority.
  authority String?
  /// [{ label, url }]: the official documents and pages this is drawn from. At least one before it can go live.
  sources    Json
  /// [{ when, what }]: dates the authority itself has given, in its words.
  milestones Json
  /// What could go wrong or should be checked, one per entry.
  watch     String[]
  /// Private to our team: what still has to be checked before this is published. Never shown to readers.
  staffNote String?
  /// "DRAFT" or "LIVE".
  status    String   @default("DRAFT")
  /// When someone on our team last checked the facts against the sources. Shown to readers.
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  interests  InvestInterest[]

  @@index([status, stateSlug])
}

/// Someone says they are interested in investing, in one area or in general. Read by our team, who follow up.
model InvestInterest {
  id       String   @id @default(cuid())
  areaId   String?
  area     InvestArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  name     String
  phone    String
  email    String?
  /// "U25L", "25_50L", "50L_1CR", "1_3CR" or "3CR_PLUS".
  budget   String?
  /// What they want: a land kind code, "HOME" or "ANY".
  wants    String?
  /// "NOW", "6M" or "LATER".
  horizon  String?
  note     String?
  status   String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
