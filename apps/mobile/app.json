{
  "expo": {
    "name": "HomeAsk",
    "slug": "homeask",
    "scheme": "homeask",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.example.homeask",
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.homeask"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of the land or space you are listing.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
